<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="drone_course">
    <!-- Miguel 409 course, Figure 5 of the proposal: 531 x 355 cm motion-capture room,
         255 cm room height, 118 cm restricted zone at the centre. Matches web/src/sample.ts COURSE
         and CONTEXT.md's course quantities table. Units: metres. -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
        </solver>
      </ode>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.75 0.8 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>2.65 1.78 5 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- Ground plane, large enough that the 5.31 x 3.55 m room sits well inside it -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Motion-capture room floor tile: 5.31 x 3.55 m, centred at (2.655, 1.775) -->
    <model name="room_floor">
      <static>true</static>
      <pose>2.655 1.775 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>5.31 3.55 0.002</size></box></geometry>
          <material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.9 0.9 0.92 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Room boundary: 255 cm high walls marking the 5.31 x 3.55 m room perimeter.
         Thin, semi-transparent (glass/netting-like) walls to visually contain drones. -->
    <model name="room_boundary">
      <static>true</static>
      <link name="wall_y_min">
        <pose>2.655 0 1.275 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>5.31 0.02 2.55</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.31 0.02 2.55</size></box></geometry>
          <material>
            <ambient>0.6 0.8 0.95 0.25</ambient>
            <diffuse>0.6 0.8 0.95 0.25</diffuse>
          </material>
        </visual>
      </link>
      <link name="wall_y_max">
        <pose>2.655 3.55 1.275 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>5.31 0.02 2.55</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.31 0.02 2.55</size></box></geometry>
          <material>
            <ambient>0.6 0.8 0.95 0.25</ambient>
            <diffuse>0.6 0.8 0.95 0.25</diffuse>
          </material>
        </visual>
      </link>
      <link name="wall_x_min">
        <pose>0 1.775 1.275 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.02 3.55 2.55</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.02 3.55 2.55</size></box></geometry>
          <material>
            <ambient>0.6 0.8 0.95 0.25</ambient>
            <diffuse>0.6 0.8 0.95 0.25</diffuse>
          </material>
        </visual>
      </link>
      <link name="wall_x_max">
        <pose>5.31 1.775 1.275 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.02 3.55 2.55</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.02 3.55 2.55</size></box></geometry>
          <material>
            <ambient>0.6 0.8 0.95 0.25</ambient>
            <diffuse>0.6 0.8 0.95 0.25</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- web/src/sample.ts COURSE: restrictedZone, centered at (2.655, 1.775),
         1.18 x 1.18 m footprint (half-size 0.59), enforced 0.0 to 1.44 m tall.
         Visual-only (no collision) since this is a logical no-fly zone, not a
         physical obstacle. -->
    <model name="restricted_zone">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <pose>2.655 1.775 0.72 0 0 0</pose>
          <geometry><box><size>1.18 1.18 1.44</size></box></geometry>
          <material>
            <ambient>0.9 0.1 0.3 0.2</ambient>
            <diffuse>0.9 0.1 0.3 0.2</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- web/src/sample.ts COURSE: obstacles O1, footprint 0.53 x 0.51 m
         centered at (1.31, 1.56), height 1.02 m, resting on the floor so
         pose z = 1.02 / 2 = 0.51. -->
